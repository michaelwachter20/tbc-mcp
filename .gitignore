# --- No job data in this repository (suite contract, rule 8) -------------------------
# This repo holds code and GENERAL TBC know-how only. Job facts go in the suite's project database (tbc_project_notes,
# outside every repo); job files stay in the user's own folders. The patterns below are a safety net so job files
# dropped in here by mistake are never committed. A file that really belongs in the repo can still be added on
# purpose with `git add -f <file>`; add a "!path" exception below for it so it stays tracked.
*.vce
*.job
*.jxl
*.rw5
*.fbk
*.dwg
*.dxf
*.dwt
*.dgn
*.pdf
*.doc
*.docx
*.xls
*.xlsx
*.xlsm
*.csv
*.ppt
*.pptx
*.msg
*.eml
*.pst
*.ost
*.zip
*.7z
*.rar
*.jpg
*.jpeg
*.png
*.tif
*.tiff
*.bmp
*.gif
*.mp4
*.mov
# Project databases of the suite (one per job, with their WAL files) and imported JSON notes files. The made-up
# test job copied from Project Analyzer's schema/ folder is the only database that belongs here.
*.db
*.db-wal
*.db-shm
*.db-journal
*.json.imported
!tests/fixtures/fixture.db

# --- Per-user / per-machine data: never commit ---------------------------------
# License profiles now live in %LOCALAPPDATA%\TBC-MCP\license (outside the repo); this is a safety net
# in case an older version or TBC_MCP_USER_DIR ever puts them back in here.
knowledge/license/
**/license/*.json
# Error popups and crash investigations: written to the learned know-how folder outside the repo since 0.4; kept
# here as a safety net for TBC_MCP_KNOWLEDGE_DIR pointed at the repository
knowledge/memory/tbc_errors.log
knowledge/memory/crash_log.md
# ...and the backups (<name>.bak1..3) and lock files (<name>.lock) of the learned files, for the same reason
knowledge/**/*.bak[0-9]
knowledge/**/*.lock
# Local MCP client config with your own paths
mcp_config.json
claude_desktop_config.json

# --- Test run output (contains coordinates from the open project) ---------------
tests/*_results.json
tests/*.txt
tests/*.log
tests/*.pdf
tests/*.png
tests/*.bmp
tests/mcp_blocks_tmp/
tests/mcp_export_tmp/
tests/mcp_import_tmp/

# --- Trimble material: rebuilt locally from each user's own SDK install ----------
tools/sdkdoc.pkl

# --- Python ---------------------------------------------------------------------
__pycache__/
*.pyc

# --- Release packages built locally (tools\make_release.ps1) ------------------------
dist/
